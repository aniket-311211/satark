# Copy to .env. Leave the two URLs commented to use SQLite at ./satark.db and the in-process event bus.
# SATARK_DATABASE_URL=postgresql+psycopg://satark:satark@localhost:5432/satark
# SATARK_REDIS_URL=redis://localhost:6379/0

# Optional: switches adverse-media extraction from keyword rules to Claude
# ANTHROPIC_API_KEY=
# SATARK_LLM_MODEL=claude-haiku-4-5

# SATARK_ALERT_THRESHOLD=80

# Free key from https://developer.company-information.service.gov.uk (REST key, Live application).
# Only needed to rebuild group B of the customer book (UK subsidiaries, their officers and owners).
# SATARK_COMPANIES_HOUSE_KEY=
